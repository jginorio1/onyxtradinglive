'use client';
import { useEffect, useState } from 'react';
import OnyxIcon from '@/app/components/OnyxIcon';

// ============================================================
// Facturación del ALUMNO en las academias que paga. Reutilizable:
//   · en Mi cuenta (sección "Academias") → todas sus academias
//   · dentro de una academia (mentorId) → solo esa
// Muestra todo: qué compró, importe, próximo cobro, cuándo expira, estado,
// facturas (con descarga), y acciones (gestionar tarjeta / cancelar / reactivar).
// ============================================================
export default function StudentBilling({ lang = 'es', mentorId }: { lang?: 'es' | 'en'; mentorId?: string }) {
  const L = mkL(lang);
  const [items, setItems] = useState<any[] | null>(null);
  const [busy, setBusy] = useState('');

  async function load() {
    const r = await fetch('/api/academy/billing' + (mentorId ? `?m=${mentorId}` : ''));
    const j = await r.json(); setItems(j.items || []);
  }
  useEffect(() => { load(); }, [mentorId]);

  function money(c: number | null, cur = 'usd') {
    if (c == null) return '—';
    const s = (cur || 'usd').toUpperCase(); const sym = s === 'USD' ? '$' : s === 'EUR' ? '€' : '';
    const n = (c / 100).toLocaleString(lang === 'en' ? 'en-US' : 'es-ES', { minimumFractionDigits: c % 100 ? 2 : 0, maximumFractionDigits: 2 });
    return sym ? sym + n : n + ' ' + s;
  }
  function when(iso: string | null, withTime = false) {
    if (!iso) return '—';
    try {
      const d = new Date(iso);
      const date = d.toLocaleDateString(lang === 'en' ? 'en-US' : 'es-ES', { day: '2-digit', month: 'short', year: 'numeric' });
      if (!withTime) return date;
      return date + ' · ' + d.toLocaleTimeString(lang === 'en' ? 'en-US' : 'es-ES', { hour: '2-digit', minute: '2-digit' });
    } catch { return '—'; }
  }
  const intv = (i: string | null) => i === 'year' ? L('/año', '/yr') : i === 'month' ? L('/mes', '/mo') : '';
  const kindLabel = (k: string) => k === 'membership' ? L('Membresía', 'Membership') : k === 'one_time' ? L('Pago único', 'One-time') : L('Nivel', 'Tier');
  function statusChip(it: any) {
    if (it.status === 'active' && it.cancel_at_period_end) return { t: L('Cancela al final', 'Cancels at period end'), c: 'var(--gold)' };
    if (it.status === 'active') return { t: L('Activa', 'Active'), c: 'var(--green)' };
    if (it.status === 'past_due') return { t: L('Pago pendiente', 'Past due'), c: 'var(--red)' };
    if (it.status === 'trialing') return { t: L('Prueba', 'Trial'), c: 'var(--brand)' };
    return { t: L('Cancelada', 'Canceled'), c: 'var(--mut)' };
  }

  async function act(action: string, mid: string, confirmMsg?: string) {
    if (confirmMsg && !window.confirm(confirmMsg)) return;
    setBusy(mid + action);
    const r = await fetch('/api/academy/billing', { method: 'POST', body: JSON.stringify({ action, mentor_id: mid }) });
    const j = await r.json(); setBusy('');
    if (action === 'portal') { if (j.url) window.location.href = j.url; else alert(L('No se pudo abrir el portal de pago.', 'Could not open the billing portal.')); return; }
    await load();
  }

  if (items === null) return <div className="muted" style={{ fontSize: 13, padding: '10px 0' }}>…</div>;
  if (!items.length) return (
    <div className="card" style={{ padding: 18, color: 'var(--mut)', fontSize: 13.5 }}>
      {L('No tienes pagos ni membresías de academias. Cuando te suscribas a la academia de un mentor, aparecerá aquí todo tu detalle de facturación.',
         'You have no academy payments or memberships. Once you subscribe to a mentor’s academy, all your billing details will show here.')}
    </div>
  );

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
      {items.map((it, idx) => {
        const st = statusChip(it);
        return (
          <div key={idx} className="card" style={{ padding: 0, overflow: 'hidden' }}>
            <div style={{ padding: '16px 18px' }}>
              <div className="row between" style={{ alignItems: 'flex-start', flexWrap: 'wrap', gap: 8 }}>
                <div style={{ minWidth: 0 }}>
                  <div style={{ fontWeight: 800, fontSize: 16, display: 'flex', alignItems: 'center', gap: 8 }}>
                    <span style={{ color: 'var(--brand)', display: 'inline-flex' }}><OnyxIcon name="graduation" size={17} /></span>{it.academy_name}
                  </div>
                  <div className="muted" style={{ fontSize: 12.5, marginTop: 2 }}>{kindLabel(it.kind)} · {it.product_name}</div>
                </div>
                <span className="pill" style={{ fontSize: 11.5, background: `color-mix(in srgb,${st.c} 16%,transparent)`, color: st.c }}>{st.t}</span>
              </div>

              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit,minmax(140px,1fr))', gap: 10, marginTop: 14 }}>
                <div><div className="muted" style={{ fontSize: 11 }}>{L('Importe', 'Amount')}</div><div style={{ fontWeight: 700, fontSize: 15 }}>{money(it.amount_cents, it.currency)}<span className="muted" style={{ fontSize: 12, fontWeight: 400 }}>{it.kind !== 'one_time' ? ' ' + intv(it.interval) : ''}</span></div></div>
                {it.kind !== 'one_time' && it.next_charge && <div><div className="muted" style={{ fontSize: 11 }}>{L('Próximo cobro', 'Next charge')}</div><div style={{ fontWeight: 700, fontSize: 15 }}>{when(it.next_charge)}</div></div>}
                {it.expires && <div><div className="muted" style={{ fontSize: 11 }}>{L('Acceso hasta', 'Access until')}</div><div style={{ fontWeight: 700, fontSize: 15 }}>{when(it.expires)}</div></div>}
                {it.started_at && <div><div className="muted" style={{ fontSize: 11 }}>{L('Desde', 'Since')}</div><div style={{ fontWeight: 700, fontSize: 15 }}>{when(it.started_at)}</div></div>}
              </div>

              {/* Acciones */}
              {it.kind !== 'one_time' && (
                <div className="row" style={{ gap: 8, marginTop: 14, flexWrap: 'wrap' }}>
                  {it.can_manage && <button className="btn btn-ghost" style={{ fontSize: 12.5 }} disabled={!!busy} onClick={() => act('portal', it.mentor_id)}><OnyxIcon name="card" size={14} glow={false} /> {L('Cambiar tarjeta / facturas', 'Update card / invoices')}</button>}
                  {it.can_manage && it.status === 'active' && !it.cancel_at_period_end &&
                    <button className="btn btn-ghost" style={{ fontSize: 12.5, color: 'var(--red)' }} disabled={busy === it.mentor_id + 'cancel'} onClick={() => act('cancel', it.mentor_id, L('¿Cancelar tu suscripción? Mantendrás el acceso hasta el fin del periodo ya pagado.', 'Cancel your subscription? You keep access until the end of the paid period.'))}>{L('Cancelar', 'Cancel')}</button>}
                  {it.can_manage && it.status === 'active' && it.cancel_at_period_end &&
                    <button className="btn btn-primary" style={{ fontSize: 12.5 }} disabled={busy === it.mentor_id + 'resume'} onClick={() => act('resume', it.mentor_id)}>{L('Reactivar', 'Resume')}</button>}
                </div>
              )}
            </div>

            {/* Facturas / historial de pagos */}
            {(it.invoices || []).length > 0 && (
              <div style={{ borderTop: '1px solid var(--line)', padding: '10px 18px 14px' }}>
                <div className="muted" style={{ fontSize: 11.5, fontWeight: 600, marginBottom: 6 }}>{L('Historial de pagos', 'Payment history')}</div>
                <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
                  {it.invoices.map((iv: any, i: number) => (
                    <div key={i} className="row between" style={{ alignItems: 'center', fontSize: 13 }}>
                      <span>{when(iv.date, true)}</span>
                      <span className="row" style={{ gap: 10, alignItems: 'center' }}>
                        <b>{money(iv.amount_cents, iv.currency)}</b>
                        <span className="muted" style={{ fontSize: 11 }}>{iv.status === 'paid' ? L('pagada', 'paid') : iv.status}</span>
                        {(iv.pdf || iv.url) && <a className="btn btn-ghost" style={{ padding: '3px 9px', fontSize: 11.5 }} href={iv.pdf || iv.url} target="_blank" rel="noreferrer"><OnyxIcon name="install" size={13} glow={false} /> {L('Recibo', 'Receipt')}</a>}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        );
      })}
      <p className="muted" style={{ fontSize: 11.5 }}>{L('Los cobros de la academia los procesa el mentor con Stripe. Aquí ves tu detalle en tiempo real.', 'Academy charges are processed by the mentor via Stripe. You see your live details here.')}</p>
    </div>
  );
}
