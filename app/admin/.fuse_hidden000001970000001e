'use client';
import { useEffect, useState } from 'react';
import { fmtDate, fmtDateTime } from '@/lib/fmtDate';
import { useLang } from '@/lib/lang';
import { useT } from '@/lib/adminText';

const T: any = {
  es: {
    notConfigured: 'Conecta tu clave de Stripe (STRIPE_SECRET_KEY en Vercel) para ver los ingresos en vivo.',
    mrr: 'MRR', arr: 'ARR proyectado', active: 'Suscripciones', arpu: 'ARPU',
    collected: 'Cobrado', failed: 'Pagos fallidos', churn: 'Churn', vsPrev: 'vs período anterior', net: 'neto',
    newS: 'nuevas', byPlan: 'Suscripciones activas por plan', moves: 'Movimientos de MRR',
    mNew: 'Nuevo (altas)', mLost: 'Perdido (cancelaciones)', mNet: 'Neto del período',
    months: 'Ingresos por mes', recent: 'Últimos cobros', noRecent: 'Sin cobros en el rango.', noPlans: 'Sin suscripciones activas.',
    thisMonth: 'Este mes', d7: '7 días', d30: '30 días', quarter: 'Trimestre', custom: 'Personalizado',
    from: 'Desde', to: 'Hasta', pdf: 'PDF', csv: 'CSV', live: 'En vivo', err: 'Stripe respondió con un error: ',
    tip: 'El MRR es tu ingreso recurrente mensual. El neto del período (altas − cancelaciones) te dice si el negocio crece o se encoge.',
  },
  en: {
    notConfigured: 'Connect your Stripe key (STRIPE_SECRET_KEY in Vercel) to see live revenue.',
    mrr: 'MRR', arr: 'Projected ARR', active: 'Subscriptions', arpu: 'ARPU',
    collected: 'Collected', failed: 'Failed payments', churn: 'Churn', vsPrev: 'vs previous period', net: 'net',
    newS: 'new', byPlan: 'Active subscriptions by plan', moves: 'MRR movements',
    mNew: 'New (sign-ups)', mLost: 'Lost (cancellations)', mNet: 'Net for period',
    months: 'Revenue by month', recent: 'Recent charges', noRecent: 'No charges in range.', noPlans: 'No active subscriptions.',
    thisMonth: 'This month', d7: '7 days', d30: '30 days', quarter: 'Quarter', custom: 'Custom',
    from: 'From', to: 'To', pdf: 'PDF', csv: 'CSV', live: 'Live', err: 'Stripe returned an error: ',
    tip: 'MRR is your recurring monthly revenue. The net for the period (sign-ups − cancellations) tells you if the business is growing or shrinking.',
  },
};

const iso = (d: Date) => d.toISOString().slice(0, 10);
function presetRange(k: string): [string, string] {
  const now = new Date();
  if (k === 'month') return [iso(new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1))), iso(now)];
  if (k === 'd7') return [iso(new Date(Date.now() - 7 * 86400000)), iso(now)];
  if (k === 'd30') return [iso(new Date(Date.now() - 30 * 86400000)), iso(now)];
  if (k === 'quarter') return [iso(new Date(Date.now() - 90 * 86400000)), iso(now)];
  return ['', ''];
}

export default function Revenue() {
  const { lang } = useLang();
  const t = T[lang];
  const gt = useT();
  const [preset, setPreset] = useState('month');
  const [from, setFrom] = useState(() => presetRange('month')[0]);
  const [to, setTo] = useState(() => presetRange('month')[1]);
  const [d, setD] = useState<any>(null);

  useEffect(() => {
    setD(null);
    const qs = `from=${from}&to=${to}&lang=${lang}`;
    fetch('/api/admin/revenue?' + qs).then((r) => r.json()).then(setD).catch(() => setD({ configured: false }));
  }, [from, to, lang]);

  function pick(k: string) {
    setPreset(k);
    if (k !== 'custom') { const [f, tt] = presetRange(k); setFrom(f); setTo(tt); }
  }
  const qs = `from=${from}&to=${to}&lang=${lang}`;
  const cur = d?.currency || 'usd';
  const money = (n: number) => new Intl.NumberFormat(lang, { style: 'currency', currency: cur.toUpperCase(), maximumFractionDigits: 0 }).format(n || 0);

  const chip = (k: string, label: string) => (
    <button key={k} className="btn btn-ghost" onClick={() => pick(k)}
      style={{ padding: '5px 12px', fontSize: 12, ...(preset === k ? { borderColor: 'var(--brand)', color: 'var(--brand)' } : {}) }}>{label}</button>
  );
  const Tile = ({ label, value, sub, subColor, color, live }: any) => (
    <div className="tile">
      <div className="muted" style={{ fontSize: 11.5 }}>{label}</div>
      <div className="row" style={{ gap: 7, marginTop: 3 }}><span style={{ fontSize: 22, fontWeight: 800, color: color || 'var(--tx)' }}>{value}</span>{live && <span className="livedot" />}</div>
      {sub && <div style={{ fontSize: 11, marginTop: 2, color: subColor || 'var(--mut)' }}>{sub}</div>}
    </div>
  );

  return (
    <>
      <div className="row between" style={{ flexWrap: 'wrap', gap: 8 }}>
        <div className="tabhead"><div className="th-row"><span className="th-ic">💰</span><span className="th-t">{gt.nav_ingresos}</span></div><div className="th-s">{gt.h_ingresos_s}</div></div>
        {d?.configured && !d?.error && <span className="pill" style={{ display: 'inline-flex', alignItems: 'center', gap: 6, color: '#7fe9c0', background: 'rgba(52,226,160,.15)' }}><span className="livedot" />{t.live}</span>}
      </div>

      {/* Filtro de fechas + exportar */}
      <div className="card" style={{ marginBottom: 12 }}>
        <div className="row" style={{ gap: 6, flexWrap: 'wrap', alignItems: 'center' }}>
          {chip('month', t.thisMonth)}{chip('d7', t.d7)}{chip('d30', t.d30)}{chip('quarter', t.quarter)}{chip('custom', t.custom)}
          <span className="row" style={{ gap: 8, marginLeft: 'auto' }}>
            <a className="btn btn-ghost" href={`/api/admin/revenue/report?${qs}`} target="_blank" rel="noreferrer" style={{ padding: '6px 12px', fontSize: 12 }}>🖨️ {t.pdf}</a>
            <a className="btn btn-ghost" href={`/api/admin/revenue?export=csv&${qs}`} style={{ padding: '6px 12px', fontSize: 12 }}>⤓ {t.csv}</a>
          </span>
        </div>
        {preset === 'custom' && (
          <div className="row" style={{ gap: 10, flexWrap: 'wrap', marginTop: 10 }}>
            <div><label className="muted" style={{ fontSize: 11.5, display: 'block' }}>{t.from}</label><input type="date" value={from} onChange={(e) => setFrom(e.target.value)} style={{ width: 150, marginTop: 3 }} /></div>
            <div><label className="muted" style={{ fontSize: 11.5, display: 'block' }}>{t.to}</label><input type="date" value={to} onChange={(e) => setTo(e.target.value)} style={{ width: 150, marginTop: 3 }} /></div>
          </div>
        )}
      </div>

      {!d && <div className="muted">…</div>}
      {d && d.configured === false && <div className="card"><p className="muted" style={{ fontSize: 14, margin: 0 }}>{t.notConfigured}</p></div>}
      {d && d.error && <div className="card"><p style={{ fontSize: 13.5, margin: 0, color: 'var(--amber)' }}>{t.err}{d.error}</p></div>}

      {d && d.configured && !d.error && (
        <>
          <div className="grid" style={{ gridTemplateColumns: 'repeat(auto-fit,minmax(120px,1fr))', gap: 10, marginBottom: 12 }}>
            <Tile label={t.mrr} value={money(d.mrr)} color="var(--green)" live sub={`${d.moveNet >= 0 ? '▲' : '▼'} ${money(Math.abs(d.moveNet))} ${t.net}`} subColor={d.moveNet >= 0 ? 'var(--green)' : 'var(--red)'} />
            <Tile label={t.arr} value={money(d.arr)} />
            <Tile label={t.active} value={d.activeSubs} sub={`+${d.newSubs} ${t.newS}`} subColor="var(--green)" />
            <Tile label={t.arpu} value={money(d.arpu)} />
            <Tile label={t.collected} value={money(d.collected)} color="var(--brand)" sub={d.collectedDelta == null ? '' : `${d.collectedDelta >= 0 ? '▲' : '▼'} ${Math.abs(d.collectedDelta)}% ${t.vsPrev}`} subColor={d.collectedDelta >= 0 ? 'var(--green)' : 'var(--red)'} />
            <Tile label={t.churn} value={d.churnPct + '%'} color={d.churnPct > 5 ? 'var(--red)' : undefined} />
          </div>

          <div className="grid g2" style={{ gap: 12, marginBottom: 12 }}>
            {/* Por plan */}
            <div className="card">
              <b style={{ fontSize: 14 }}>{t.byPlan}</b>
              <div style={{ marginTop: 12 }}>
                {!d.plans.length && <p className="muted" style={{ fontSize: 13 }}>{t.noPlans}</p>}
                {d.plans.map((p: any, i: number) => (
                  <div key={i} style={{ marginBottom: 12 }}>
                    <div className="row between" style={{ fontSize: 12.5, marginBottom: 4 }}>
                      <span style={{ fontWeight: 700 }}>{p.name} · {p.subs}</span>
                      <span className="muted">{money(p.mrr)} · {p.pct}%</span>
                    </div>
                    <div style={{ height: 8, background: 'var(--bg2)', borderRadius: 999, overflow: 'hidden' }}>
                      <div style={{ height: '100%', width: Math.max(p.pct, 2) + '%', background: ['#7c8cff', '#34e2a0', '#3ad0ff', '#b98bff', '#ffd45e'][i % 5] }} />
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* Movimientos de MRR */}
            <div className="card">
              <b style={{ fontSize: 14 }}>{t.moves}</b>
              <div style={{ marginTop: 10 }}>
                <div className="row between" style={{ padding: '9px 0', fontSize: 13 }}><span>↗ {t.mNew}</span><span style={{ fontWeight: 700, color: 'var(--green)' }}>+{money(d.moveNew)}</span></div>
                <div className="row between" style={{ padding: '9px 0', borderTop: '1px solid var(--line)', fontSize: 13 }}><span>↘ {t.mLost}</span><span style={{ fontWeight: 700, color: 'var(--red)' }}>−{money(d.moveLost)}</span></div>
                <div className="row between" style={{ padding: '10px 0 0', marginTop: 4, borderTop: '1px solid var(--line)', fontSize: 13, fontWeight: 700 }}><span>{t.mNet}</span><span style={{ color: d.moveNet >= 0 ? 'var(--green)' : 'var(--red)' }}>{d.moveNet >= 0 ? '+' : ''}{money(d.moveNet)}</span></div>
              </div>
            </div>
          </div>

          {/* Gráfico por mes */}
          <div className="card" style={{ marginBottom: 12 }}>
            <b style={{ fontSize: 14 }}>{t.months}</b>
            <div style={{ display: 'flex', alignItems: 'flex-end', gap: 10, height: 130, marginTop: 14 }}>
              {(() => { const max = Math.max(1, ...d.monthly.map((x: any) => x.total)); return d.monthly.map((x: any, i: number) => (
                <div key={i} style={{ flex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 6 }}>
                  <div className="muted" style={{ fontSize: 10.5 }}>{money(x.total)}</div>
                  <div style={{ width: '100%', height: Math.round((x.total / max) * 90) + 4, background: i === d.monthly.length - 1 ? 'var(--green)' : 'rgba(52,226,160,.4)', borderRadius: '4px 4px 0 0' }} />
                  <div className="muted" style={{ fontSize: 11 }}>{x.label}</div>
                </div>
              )); })()}
            </div>
          </div>

          {/* Últimos cobros */}
          <div className="card">
            <b style={{ fontSize: 14 }}>{t.recent}</b>
            {!d.recent?.length && <p className="muted" style={{ fontSize: 13, marginTop: 8 }}>{t.noRecent}</p>}
            {d.recent?.map((r: any, i: number) => (
              <div key={i} className="row between" style={{ borderTop: '1px solid var(--line)', padding: '9px 0', fontSize: 13, gap: 8, flexWrap: 'wrap' }}>
                <span className="row" style={{ gap: 8 }}><span style={{ width: 7, height: 7, borderRadius: '50%', background: r.ok ? '#34e2a0' : '#ff6b7d' }} />{r.email || '—'}</span>
                <span className="row" style={{ gap: 12 }}><span style={{ fontWeight: 700, color: r.ok ? 'var(--green)' : 'var(--red)' }}>{money(r.amount)}</span><span className="muted" style={{ fontSize: 12 }}>{fmtDate(r.at * 1000, lang)}</span></span>
              </div>
            ))}
            <div className="muted" style={{ fontSize: 11.5, marginTop: 10 }}>{t.tip}</div>
          </div>
        </>
      )}
    </>
  );
}
