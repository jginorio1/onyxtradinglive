'use client';
import { useEffect, useState } from 'react';
import { fmtDate, fmtDateTime } from '@/lib/fmtDate';
import { useLang } from '@/lib/lang';
import { useT } from '@/lib/adminText';

const T: any = {
  es: {
    intro: 'No solo mide: optimiza sola. Cada trabajo corre en su horario y aquí ves el resultado.',
    on: 'Automática', off: 'En pausa',
    total: 'Ahorro total', dbSize: 'Tamaño de la BD', rows: 'Filas totales', next: 'Próxima',
    dbTitle: 'Limpieza y afinado de BD', dbDesc: 'Purga logs viejos (>90 días) y afina la base · semanal',
    last: 'Última', never: 'Nunca', analyzedYes: 'afinado ✓', analyzedNo: 'afinado pendiente',
    run: 'Ejecutar ahora', running: 'Optimizando…',
    clean: 'Base limpia, nada que purgar', doneN: 'filas purgadas', done: 'Optimización completada',
    history: 'Historial', noHistory: 'Sin ejecuciones aún.', pruned: 'purgadas',
    bigTables: 'Tablas más grandes', noTables: 'Corre optimize_v2.sql en Supabase para ver los tamaños.',
    imgTitle: 'Fotos del diario', imgCount: 'Optimizadas', imgSaved: 'Espacio ahorrado', imgNote: 'Se llena cuando los traders suban fotos a sus operaciones.',
    fixTitle: 'Auto-arreglos (PRs)', fixDesc: 'Dependabot abre PRs de actualizaciones y seguridad; los menores se auto-fusionan. Tú apruebas el resto.',
    budgetTitle: 'Presupuestos de rendimiento', budgetDesc: 'La auditoría avisa (y puede bloquear) si una nota baja del umbral.',
    cacheTitle: 'Caché y cabeceras', cacheDesc: 'Cache-Control óptimo en imágenes e íconos → repetir visita casi instantánea.', active: 'Activo',
  },
  en: {
    intro: 'It doesn’t just measure: it optimizes itself. Each job runs on schedule and you see the result here.',
    on: 'Automatic', off: 'Paused',
    total: 'Total saved', dbSize: 'Database size', rows: 'Total rows', next: 'Next',
    dbTitle: 'Database cleanup and tuning', dbDesc: 'Prunes old logs (>90 days) and tunes the DB · weekly',
    last: 'Last', never: 'Never', analyzedYes: 'tuned ✓', analyzedNo: 'tuning pending',
    run: 'Run now', running: 'Optimizing…',
    clean: 'Database clean, nothing to prune', doneN: 'rows pruned', done: 'Optimization done',
    history: 'History', noHistory: 'No runs yet.', pruned: 'pruned',
    bigTables: 'Biggest tables', noTables: 'Run optimize_v2.sql in Supabase to see sizes.',
    imgTitle: 'Journal photos', imgCount: 'Optimized', imgSaved: 'Space saved', imgNote: 'Fills up when traders upload photos to their trades.',
    fixTitle: 'Auto-fixes (PRs)', fixDesc: 'Dependabot opens update and security PRs; minor ones auto-merge. You approve the rest.',
    budgetTitle: 'Performance budgets', budgetDesc: 'The audit warns (and can block) if a score drops below the threshold.',
    cacheTitle: 'Cache and headers', cacheDesc: 'Optimal Cache-Control on images and icons → repeat visits nearly instant.', active: 'Active',
  },
};

const fmtB = (n: number) => (!n ? '—' : n < 1024 * 1024 ? Math.round(n / 1024) + ' KB' : (n / 1024 / 1024).toFixed(1) + ' MB');
function nextSunday(): string {
  const d = new Date();
  const add = (7 - d.getDay()) % 7 || 7;
  d.setDate(d.getDate() + add);
  return d.toLocaleDateString(undefined, { day: '2-digit', month: '2-digit' }) + ' · 05:00';
}

function Ic({ e }: { e: string }) {
  return <span style={{ width: 32, height: 32, borderRadius: 9, background: 'rgba(124,140,255,.16)', display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: 16, flex: 'none' }}>{e}</span>;
}

export default function Optimize() {
  const { lang } = useLang();
  const t = T[lang];
  const gt = useT();
  const [d, setD] = useState<any>(null);
  const [busy, setBusy] = useState(false);
  const [msg, setMsg] = useState('');

  async function load() { try { const r = await fetch('/api/admin/optimize'); setD(await r.json()); } catch { setD({}); } }
  useEffect(() => { load(); }, []);

  const o = d?.optimize || { enabled: true, last_at: null, pruned_errors: 0, pruned_tg: 0, analyzed: false, images: { count: 0, saved_bytes: 0 }, history: [] };
  const recent = o.last_at && (Date.now() - new Date(o.last_at).getTime()) < 8 * 86400000;
  const tables: any[] = d?.tables || [];
  const dbBytes = d?.db_bytes || 0;
  const totalRows = tables.reduce((s, x) => s + (x.rows || 0), 0);
  const maxBytes = Math.max(1, ...tables.map((x) => x.bytes || 0));

  async function runNow() {
    setBusy(true); setMsg('');
    try {
      const r = await fetch('/api/admin/optimize', { method: 'POST' });
      const j = await r.json();
      const total = (j.pruned_errors || 0) + (j.pruned_tg || 0);
      setMsg(`${t.done} · ${total === 0 ? t.clean : total.toLocaleString() + ' ' + t.doneN}${j.analyzed ? ' · ' + t.analyzedYes : ''}`);
    } catch {}
    await load(); setBusy(false);
    setTimeout(() => setMsg(''), 8000);
  }
  async function toggle() { await fetch('/api/admin/optimize', { method: 'PATCH', body: JSON.stringify({ enabled: !o.enabled }) }); await load(); }

  const Tog = ({ on, onClick }: { on: boolean; onClick: () => void }) => (
    <span className="toggle" onClick={onClick} style={{ background: on ? '#34e2a0' : '#556080', cursor: 'pointer' }}><span className="knob" style={{ left: on ? 21 : 3 }} /></span>
  );
  const tile = (label: string, value: any, color?: string) => (
    <div className="tile"><div className="muted" style={{ fontSize: 11.5 }}>{label}</div><div style={{ fontSize: 18, fontWeight: 700, marginTop: 3, color: color || 'var(--tx)' }}>{value}</div></div>
  );

  return (
    <>
      <div className="row between" style={{ flexWrap: 'wrap', gap: 8 }}>
        <div className="tabhead"><div className="th-row"><span className="th-ic">🚀</span><span className="th-t">{gt.h_optim_t}</span></div><div className="th-s">{t.intro}</div></div>
        <div className="row" style={{ gap: 8 }}>
          <span className="pill" style={{ display: 'inline-flex', alignItems: 'center', gap: 6, color: o.enabled ? '#7fe9c0' : 'var(--mut)', background: o.enabled ? 'rgba(52,226,160,.15)' : 'var(--card2)' }}>{o.enabled && recent && <span className="livedot" />}{o.enabled ? t.on : t.off}</span>
          <button className="btn btn-primary" onClick={runNow} disabled={busy}>{busy ? t.running : '▶ ' + t.run}</button>
        </div>
      </div>

      {msg && <div className="card" style={{ border: '1px solid var(--green)', background: 'rgba(52,226,160,.08)', color: 'var(--green)', fontSize: 13 }}>✓ {msg}</div>}

      {/* Titulares */}
      <div className="grid g4" style={{ marginBottom: 12 }}>
        {tile(t.total, fmtB(o.images?.saved_bytes ?? 0), 'var(--green)')}
        {tile(t.dbSize, fmtB(dbBytes))}
        {tile(t.rows, totalRows.toLocaleString())}
        <div className="tile"><div className="muted" style={{ fontSize: 11.5 }}>{t.next}</div><div style={{ fontSize: 15, fontWeight: 700, marginTop: 3 }}>{nextSunday()}</div></div>
      </div>

      {/* Limpieza + historial */}
      <div className="card" style={{ marginBottom: 12 }}>
        <div className="row between" style={{ marginBottom: 8 }}>
          <div className="row"><Ic e="🧹" /><div><b style={{ fontSize: 13.5 }}>{t.dbTitle}</b><div className="muted" style={{ fontSize: 11.5 }}>{t.dbDesc}</div></div></div>
          <Tog on={o.enabled} onClick={toggle} />
        </div>
        <div className="row between" style={{ fontSize: 12.5, padding: '8px 0', borderTop: '1px solid var(--line)' }}>
          <span className="muted">{t.last}</span>
          <span>{o.last_at ? fmtDateTime(o.last_at, lang) : t.never} {o.last_at && <span className="muted">· {o.analyzed ? t.analyzedYes : t.analyzedNo}</span>}</span>
        </div>
        <div className="muted" style={{ fontSize: 11.5, margin: '8px 0 4px' }}>{t.history}</div>
        {!(o.history?.length) && <p className="muted" style={{ fontSize: 12.5 }}>{t.noHistory}</p>}
        {(o.history || []).map((h: any, i: number) => {
          const total = (h.pruned_errors || 0) + (h.pruned_tg || 0);
          return (
            <div key={i} className="row between" style={{ fontSize: 12.5, padding: '7px 0', borderTop: '1px solid var(--line)' }}>
              <span>{fmtDateTime(h.at, lang)}</span>
              <span className="muted">{total === 0 ? t.clean : total.toLocaleString() + ' ' + t.pruned}{h.analyzed ? ' · ' + t.analyzedYes : ''}</span>
            </div>
          );
        })}
      </div>

      {/* Tablas más grandes + Fotos */}
      <div className="row" style={{ gap: 11, alignItems: 'stretch', flexWrap: 'wrap' }}>
        <div className="card" style={{ flex: 1, minWidth: 260, margin: 0 }}>
          <div className="row" style={{ marginBottom: 8 }}><Ic e="📊" /><b style={{ fontSize: 13.5 }}>{t.bigTables}</b></div>
          {!tables.length && <p className="muted" style={{ fontSize: 12 }}>{t.noTables}</p>}
          {tables.slice(0, 6).map((x, i) => (
            <div key={i} className="row" style={{ gap: 8, fontSize: 12, margin: '6px 0' }}>
              <span style={{ width: 90, color: 'var(--mut)', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{x.name}</span>
              <span style={{ flex: 1, height: 6, borderRadius: 6, background: 'var(--bg2)', overflow: 'hidden' }}><span style={{ display: 'block', height: '100%', width: `${Math.round((x.bytes / maxBytes) * 100)}%`, background: 'var(--brand)' }} /></span>
              <b style={{ width: 58, textAlign: 'right' }}>{fmtB(x.bytes)}</b>
            </div>
          ))}
        </div>
        <div className="card" style={{ flex: 1, minWidth: 260, margin: 0 }}>
          <div className="row" style={{ marginBottom: 8 }}><Ic e="🖼️" /><b style={{ fontSize: 13.5 }}>{t.imgTitle}</b><span className="pill" style={{ marginLeft: 'auto', color: '#7fe9c0', background: 'rgba(52,226,160,.15)' }}>{t.active}</span></div>
          <div className="grid g2" style={{ gap: 9 }}>
            {tile(t.imgCount, (o.images?.count ?? 0).toLocaleString())}
            {tile(t.imgSaved, fmtB(o.images?.saved_bytes ?? 0), 'var(--green)')}
          </div>
          <div className="muted" style={{ fontSize: 11.5, marginTop: 8 }}>{t.imgNote}</div>
        </div>
      </div>

      {/* Auto-arreglos + Presupuestos + Caché */}
      <div className="grid g2" style={{ gap: 12, marginTop: 12 }}>
        <div className="card" style={{ margin: 0 }}><div className="row"><Ic e="🤖" /><b style={{ fontSize: 13.5 }}>{t.fixTitle}</b></div><div className="muted" style={{ fontSize: 12, marginTop: 8 }}>{t.fixDesc}</div></div>
        <div className="card" style={{ margin: 0 }}><div className="row"><Ic e="🎯" /><b style={{ fontSize: 13.5 }}>{t.budgetTitle}</b></div><div className="muted" style={{ fontSize: 12, marginTop: 8 }}>{t.budgetDesc}</div></div>
      </div>
      <div className="card" style={{ marginTop: 12 }}>
        <div className="row"><Ic e="⚡" /><b style={{ fontSize: 13.5 }}>{t.cacheTitle}</b><span className="pill" style={{ marginLeft: 'auto', color: '#7fe9c0', background: 'rgba(52,226,160,.15)' }}><span className="livedot" />{t.active}</span></div>
        <div className="muted" style={{ fontSize: 12, marginTop: 8 }}>{t.cacheDesc}</div>
      </div>
    </>
  );
}
