# ===== Onyx Trading Live · variables de entorno =====
# Copia este archivo como .env.local y rellena con tus claves.

# --- Supabase ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # service_role (SECRETO, solo backend)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...    # anon (frontend)

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_PRO=price_...              # ID del precio del plan Pro (en Stripe)
STRIPE_PRICE_ELITE=price_...            # ID del precio del plan Elite

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=tu-email@ejemplo.com       # emails con acceso al panel de admin (separa por comas)
