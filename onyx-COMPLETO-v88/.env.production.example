# ===================================================================
# Onyx Trading Live · variables de PRODUCCIÓN (stable / clientes reales)
# Ponlas en el proyecto Vercel de PRODUCCIÓN (Environment: Production).
# El MISMO código corre en beta; aquí solo cambian estos valores.
# NUNCA mezcles claves live (aquí) con las de beta (test).
# ===================================================================

# --- Identidad del entorno ---
NEXT_PUBLIC_APP_ENV=production            # 'production' => sin banner de pruebas
NEXT_PUBLIC_APP_URL=https://www.onyxtradinglive.com
# El switch admin salta entre estas dos (iguales en prod y en beta):
NEXT_PUBLIC_PROD_URL=https://www.onyxtradinglive.com
NEXT_PUBLIC_BETA_URL=https://beta.onyxtradinglive.com
BETA_SWITCH_PIN=123456                    # PIN de 6 dígitos para cambiar de entorno

# --- Supabase (PROYECTO onyx-prod) ---
SUPABASE_URL=https://ONYX-PROD.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # service_role de onyx-prod (SECRETO)
NEXT_PUBLIC_SUPABASE_URL=https://ONYX-PROD.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...      # anon de onyx-prod

# --- Stripe (MODO LIVE — dinero real) ---
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...           # webhook de Stripe apuntando a la URL de PROD
STRIPE_PRICE_PRO=price_...                # price IDs del modo LIVE
STRIPE_PRICE_ELITE=price_...

# --- IA (puede compartirse con beta) ---
ANTHROPIC_API_KEY=sk-ant-...
ONYX_AI_MODEL=claude-haiku-4-5

# --- Correo (Resend) ---
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
SUPPORT_FROM_EMAIL=soporte@onyxtradinglive.com
EMAIL_LOGO_URL=https://www.onyxtradinglive.com/onyx-symbol.png

# --- Telegram (BOT REAL de producción) ---
TELEGRAM_BOT_TOKEN=...
TELEGRAM_BOT_USERNAME=OnyxTradingBot
TELEGRAM_WEBHOOK_SECRET=...

# --- Push (VAPID) ---
VAPID_PUBLIC_KEY=...
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:soporte@onyxtradinglive.com

# --- Crons / seguridad ---
CRON_SECRET=una-cadena-larga-secreta-PROD
BACKUP_SECRET=otra-cadena-larga-PROD
ADMIN_EMAILS=tu-email@ejemplo.com

# --- Academia / otros ---
ONYX_ACADEMY_FEE_PCT=10                   # % de plataforma sobre ventas de academias
ACADEMY_WEBHOOK_SECRET=...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=...
