# ===================================================================
# Onyx Trading Live · variables de BETA (pruebas / staging)
# Ponlas en el proyecto Vercel de BETA (Environment: Production de ESE proyecto,
# o en Preview si usas un solo proyecto).
# Mismo código que producción; SOLO cambian estos valores.
# Datos y pagos NO son reales aquí.
# ===================================================================

# --- Identidad del entorno ---
NEXT_PUBLIC_APP_ENV=beta                  # 'beta' => muestra la franja "ENTORNO DE PRUEBAS"
NEXT_PUBLIC_APP_URL=https://beta.onyxtradinglive.com
NEXT_PUBLIC_PROD_URL=https://www.onyxtradinglive.com
NEXT_PUBLIC_BETA_URL=https://beta.onyxtradinglive.com
BETA_SWITCH_PIN=123456

# --- Supabase (PROYECTO onyx-beta — DISTINTO de prod) ---
SUPABASE_URL=https://ONYX-BETA.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # service_role de onyx-beta
NEXT_PUBLIC_SUPABASE_URL=https://ONYX-BETA.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...      # anon de onyx-beta

# --- Stripe (MODO TEST — sin dinero real) ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...           # webhook de Stripe (test) apuntando a la URL de BETA
STRIPE_PRICE_PRO=price_...                # price IDs del modo TEST
STRIPE_PRICE_ELITE=price_...

# --- IA (puede compartirse con prod) ---
ANTHROPIC_API_KEY=sk-ant-...
ONYX_AI_MODEL=claude-haiku-4-5

# --- Correo (Resend) — usa un remitente/dominio de pruebas si puedes ---
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
SUPPORT_FROM_EMAIL=beta@onyxtradinglive.com
EMAIL_LOGO_URL=https://beta.onyxtradinglive.com/onyx-symbol.png

# --- Telegram (BOT DISTINTO para no chocar con el de producción) ---
TELEGRAM_BOT_TOKEN=...                     # crea un 2º bot de pruebas en @BotFather
TELEGRAM_BOT_USERNAME=OnyxTradingBetaBot
TELEGRAM_WEBHOOK_SECRET=...

# --- Push (VAPID) — genera un par distinto para beta ---
VAPID_PUBLIC_KEY=...
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:beta@onyxtradinglive.com

# --- Crons / seguridad ---
CRON_SECRET=una-cadena-larga-secreta-BETA
BACKUP_SECRET=otra-cadena-larga-BETA
ADMIN_EMAILS=tu-email@ejemplo.com

# --- Academia / otros ---
ONYX_ACADEMY_FEE_PCT=10
ACADEMY_WEBHOOK_SECRET=...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=...
